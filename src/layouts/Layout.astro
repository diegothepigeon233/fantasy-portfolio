---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A running archive of my fantasy sports seasons.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-ink text-slate-100">
    <header class="border-b border-edge">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
        <a href="/" class="flex items-center gap-3">
          <span class="text-sm font-semibold tracking-widest uppercase">
            Fantasy<span class="text-sky-400">Portfolio</span>
          </span>
          <span class="h-4 w-px bg-edge" aria-hidden="true"></span>
          <span class="font-cjk text-base leading-none text-slate-300">蒂亚鸽</span>
        </a>
        <a href="/" class="text-sm text-muted transition hover:text-slate-100">Leagues</a>
      </nav>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-12">
      <slot />
    </main>

    <footer class="mx-auto max-w-5xl px-6 py-12 text-xs text-muted">
      Updated monthly from a spreadsheet kept in the repo.
    </footer>
  </body>
</html>
