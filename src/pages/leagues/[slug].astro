---
import Layout from '../../layouts/Layout.astro';
import {
  getLeagues,
  getSeasons,
  getMiniLeagues,
  miniLeaguesBySeason,
  percentile,
  commas,
  type League,
  type Season,
  type MiniLeague,
} from '../../lib/data';

// One page per row of the `leagues` sheet, generated at build time.
export async function getStaticPaths() {
  const [leagues, seasons, minis] = await Promise.all([
    getLeagues(),
    getSeasons(),
    getMiniLeagues(),
  ]);
  return leagues.map((league) => ({
    params: { slug: league.slug },
    props: {
      league,
      rows: seasons.filter((s) => s.league === league.slug),
      minis: minis.filter((m) => m.league === league.slug),
    },
  }));
}

const { league, rows, minis } = Astro.props as {
  league: League;
  rows: Season[];
  minis: MiniLeague[];
};

const miniSeasons = miniLeaguesBySeason(minis);

// A season row with no numbers yet is one that's still being played, not one
// with missing data — show a badge instead of a grid of em dashes.
const hasResults = (s: Season) =>
  s.points != null || s.overallRank != null || s.pctFinish !== '' || s.miniLeagueRank != null;
---

<Layout title={`${league.name} — Fantasy Portfolio`}>
  <a href="/" class="text-sm text-muted transition hover:text-slate-100">&larr; All leagues</a>

  <header class="mt-6 mb-10 border-b border-edge pb-8">
    <div class="flex items-center gap-3">
      <span class="h-3 w-3 rounded-full" style={`background:${league.accent}`} aria-hidden="true" />
      <span class="text-xs tracking-widest text-muted uppercase">{league.sport}</span>
    </div>
    <h1 class="mt-3 text-4xl font-bold tracking-tight">{league.name}</h1>
    {league.blurb && <p class="mt-3 max-w-2xl text-muted">{league.blurb}</p>}
  </header>

  {
    rows.length === 0 ? (
      // Leagues like NBA and NFL have no official competition to record — only
      // private leagues. Staying silent is right there; the placeholder only
      // makes sense when the page would otherwise be completely empty.
      minis.length === 0 && <p class="text-muted">Nothing recorded here yet.</p>
    ) : (
      <div class="space-y-4">
        {rows.map((s) => (
          <article class="rounded-2xl border border-edge bg-panel p-6">
            <div class="flex flex-wrap items-baseline justify-between gap-3">
              <div>
                <h2 class="text-xl font-semibold">{s.season}</h2>
                {s.teamName && <p class="text-sm text-muted">{s.teamName}</p>}
              </div>
              {s.result ? (
                <span
                  class={`rounded-full px-3 py-1 text-xs font-semibold ${
                    s.highlight ? 'bg-sky-400/15 text-sky-300' : 'bg-slate-100/5 text-slate-300'
                  }`}
                >
                  {s.result}
                </span>
              ) : (
                !hasResults(s) && (
                  <span class="rounded-full bg-sky-400/15 px-3 py-1 text-xs font-semibold text-sky-300">
                    In progress
                  </span>
                )
              )}
            </div>

            <dl
              class:list={[
                'mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4',
                !hasResults(s) && 'hidden',
              ]}
            >
              <div>
                <dt class="text-xs text-muted uppercase">Points</dt>
                <dd class="mt-1 text-lg font-semibold tabular-nums">{commas(s.points)}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted uppercase">Overall rank</dt>
                <dd class="mt-1 text-lg font-semibold tabular-nums">{commas(s.overallRank)}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted uppercase">Percentile</dt>
                <dd class="mt-1 text-lg font-semibold">{percentile(s) ?? '—'}</dd>
              </div>
              <div>
                <dt class="text-xs text-muted uppercase">{s.miniLeague || 'Mini-league'}</dt>
                <dd class="mt-1 text-lg font-semibold tabular-nums">
                  {s.miniLeagueRank
                    ? `${s.miniLeagueRank}${s.miniLeagueSize ? ` / ${s.miniLeagueSize}` : ''}`
                    : '—'}
                </dd>
              </div>
            </dl>

            {s.notes && (
              <p class="mt-5 border-t border-edge pt-4 text-sm text-slate-300">{s.notes}</p>
            )}
          </article>
        ))}
      </div>
    )
  }

  {
    miniSeasons.length > 0 && (
      <section class="mt-14">
        <div class="mb-5 flex items-center gap-4">
          <h2 class="text-xs font-semibold tracking-widest text-muted uppercase">
            Private mini-leagues
          </h2>
          <span class="h-px flex-1 bg-edge" aria-hidden="true" />
        </div>

        {miniSeasons.map(({ season, entries }) => (
          <div class="mb-7">
            <h3 class="mb-3 text-sm font-semibold text-slate-400">{season}</h3>
            <div class="grid gap-3 sm:grid-cols-2">
              {entries.map((m) => (
                <div class="rounded-xl border border-edge bg-panel p-5">
                  <div class="flex items-start justify-between gap-3">
                    <span class="min-w-0 font-medium">{m.host}</span>
                    {m.result ? (
                      <span class="shrink-0 rounded-full bg-slate-100/5 px-2.5 py-0.5 text-xs whitespace-nowrap text-slate-300">
                        {m.result}
                      </span>
                    ) : (
                      <span class="shrink-0 rounded-full bg-sky-400/15 px-2.5 py-0.5 text-xs font-medium whitespace-nowrap text-sky-300">
                        In progress
                      </span>
                    )}
                  </div>
                  {m.format && <p class="mt-1 text-sm text-muted">{m.format}</p>}
                  {m.teamName && <p class="mt-3 text-sm text-slate-300">{m.teamName}</p>}
                </div>
              ))}
            </div>
          </div>
        ))}
      </section>
    )
  }
</Layout>
